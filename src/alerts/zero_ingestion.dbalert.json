{
  "evaluation": {
    "source": {
      "name": "today_count",
      "display": "today_count",
      "aggregation": "SUM"
    },
    "comparison_operator": "EQUAL",
    "threshold": {
      "value": {
        "double_value": 0.0
      }
    },
    "notification": {}
  },
  "schedule": {
    "quartz_cron_schedule": "39 0 9 * * ?",
    "timezone_id": "Europe/Kiev"
  },
  "query_lines": [
    "SELECT COUNT(*) AS today_count",
    "FROM dbr_dev.liebiedieva_gold.fact_sales",
    "WHERE date_key = CAST(DATE_FORMAT(CURRENT_DATE, 'yyyyMMdd') AS INT)"
  ]
}
